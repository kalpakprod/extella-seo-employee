# Non-secret Docker Compose settings. Copy to deploy/.env only when overrides are needed.
COMPOSE_PROJECT_NAME=extella-seo-employee
SEO_EMPLOYEE_PORT=8088
AGENT_ZERO_PORT=50081
AGENT_ZERO_VOLUME=extella_seo_agent_zero_usr
# External Agent Zero only. It must be a local origin such as http://host.docker.internal:50081.
AGENT_ZERO_UPSTREAM=http://agent-zero:80
# Required runtime contract, consumed by the product container configuration.
EXTELLA_AGENT_ZERO_NO_TOOLS_PROFILE=seo_employee_no_tools
