#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  echo "usage: run_seomator <public-url> <output-json> <plan-json>" >&2
  exit 2
fi

output_dir=$(dirname "$2")
output_name=$(basename "$2")
mkdir -p "$output_dir"
output_dir=$(cd "$output_dir" && pwd -P)
plan_dir=$(dirname "$3")
plan_name=$(basename "$3")
plan_dir=$(cd "$plan_dir" && pwd -P)
plan_path="$plan_dir/$plan_name"
test -r "$plan_path" || { echo "SEOmator plan is not readable" >&2; exit 2; }

exec docker run --rm \
  --mount "type=bind,src=$output_dir,dst=/output" \
  --mount "type=bind,src=$plan_path,dst=/run/plan.json,readonly" \
  --tmpfs /work:rw,noexec,nosuid,size=64m \
  extella-seo-seomator:2.0.0 "$1" "/output/$output_name" "/run/plan.json"
